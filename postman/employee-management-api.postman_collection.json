{
  "info": {
    "_postman_id": "9f1c2d3e-4b5a-4c6d-8e7f-0a1b2c3d4e5f",
    "name": "Employee Management API",
    "description": "Colección de Postman para la API de gestión de empleados, departamentos y proyectos.\n\n- Base URL configurable con la variable `baseUrl` (por defecto `http://localhost:3000`).\n- Documentación Swagger disponible en `{{baseUrl}}/docs`.\n- Los endpoints protegidos requieren un token JWT Bearer. Inicia sesión con los requests de la carpeta **Autenticación** para guardar automáticamente el token en la variable `token`.\n- Rol `User` puede consultar (GET); las mutaciones (POST, PUT, DELETE) requieren rol `Admin`.\n\nVariables útiles: `employeeId`, `departmentId` y `projectId` se rellenan con las respuestas de los endpoints de creación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Estado del servidor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Comprueba que la API responda y que la conexión a la base de datos esté activa."
          },
          "auth": {
            "type": "noauth"
          }
        }
      ],
      "description": "Endpoints de operación de la API."
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Crea un usuario con rol `User`. La contraseña debe tener al menos 8 caracteres."
          },
          "auth": {
            "type": "noauth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registro exitoso', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Inicia sesión con un usuario registrado y guarda el token JWT en la variable `token` para el resto de la colección."
          },
          "auth": {
            "type": "noauth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Login exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('token', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión como Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Inicia sesión con el admin sembrado por defecto (`admin@example.com` / `Admin1234`) y guarda su token para poder ejecutar mutaciones (POST, PUT, DELETE)."
          },
          "auth": {
            "type": "noauth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Login admin exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('token', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "description": "Registro e inicio de sesión. Devuelven `{ \"token\": \"...\", \"expiresAt\": \"...\" }`."
    },

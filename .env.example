# Aplicación
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# CORS (orígenes permitidos separados por coma; vacío = CORS deshabilitado)
CORS_ORIGINS=http://localhost:5173

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=employee
DB_PASSWORD=employee
DB_NAME=employee_management

# Autenticación
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# Usuario administrador por defecto (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234
